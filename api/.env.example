PORT=3001
HOST=127.0.0.1
TRUST_PROXY=false
NODE_ENV=development
LOG_LEVEL=debug

# Model provider. Needed to draft a report against a real model; get one from
# platform.openai.com. Leave this empty to run sign-in, upload, preprocessing,
# signal quality, and event detection without a model.
OPENAI_API_KEY=

# Demo mode. Three things at once: every analysis pass returns fixed, plainly
# non-clinical text instead of calling a provider; the sign-in screen offers a
# keyless demo user; and the interface shows a banner for as long as it is on.
# Takes precedence over OPENAI_API_KEY when both are set. Never leave it on
# anywhere it could be mistaken for a working deployment.
# SOMNOSCRIBE_DEMO_MODE=true
# Optional safety cap for live anonymous demo sessions. Invalid values fall
# back to 24; this prevents rotating visitors from growing the temporary user
# table without bound.
# SOMNOSCRIBE_DEMO_MAX_ACTIVE_PRINCIPALS=24

# JWT secret — required in production (min 32 bytes). Left empty on purpose:
# any value committed here is public, and the API rejects published examples in
# production rather than accepting one that merely looks long enough.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# SQLite database path (relative to api/ dir)
DB_PATH=./data/cases.sqlite

# Preprocessor sidecar
PREPROCESSOR_URL=http://localhost:8001

# Optional directory of validated reference-pack Markdown files.
# Leave unset to boot normally with deterministic reference checks disabled.
# REFERENCE_DIR=/absolute/path/outside/this/repository

# Directories for preprocessor output (defaults match constants.ts)
CHARTS_DIR=../preprocessor/data/charts
SLICES_DIR=../preprocessor/data/slices
SCREENSHOTS_DIR=../data/screenshots

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_MAX=10

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model overrides (defaults match constants.ts)
GPT_MODEL=gpt-5.4-mini
NANO_MODEL=gpt-5.4-nano

# Feature flags
ENABLE_BULK_CASE_DELETE=false
