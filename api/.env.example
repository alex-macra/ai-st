PORT=3001
HOST=127.0.0.1
TRUST_PROXY=false
NODE_ENV=development
LOG_LEVEL=debug

# Model provider. Set this to draft reports against a real model; get a key from
# platform.openai.com. Leave it empty and every analysis pass is answered by the
# offline generator instead — fixed, plainly non-clinical text, with a banner on
# screen for as long as that mode is in use. There is no third state: the
# presence of a key is the whole configuration.
OPENAI_API_KEY=

# Optional shared access token. Somnoscribe has no accounts; it is a
# single-operator workspace that binds loopback and serves every request. Set
# this and each /api request must carry it as a bearer token — the one guard for
# an operator who exposes the port anyway. It is a shared secret, not an
# identity: sign-off records the reviewer's typed name separately.
# SOMNOSCRIBE_ACCESS_TOKEN=

# SQLite database path (relative to api/ dir)
DB_PATH=./data/cases.sqlite

# Preprocessor sidecar
PREPROCESSOR_URL=http://localhost:8001

# Optional directory of validated reference-pack Markdown files.
# Leave unset to boot normally with deterministic reference checks disabled.
# REFERENCE_DIR=/absolute/path/outside/this/repository

# Directories for preprocessor output (defaults match constants.ts)
CHARTS_DIR=../preprocessor/data/charts
SLICES_DIR=../preprocessor/data/slices
SCREENSHOTS_DIR=../data/screenshots

# Rate limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=600000
UPLOAD_RATE_LIMIT_MAX=5

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model overrides (defaults match constants.ts)
GPT_MODEL=gpt-5.4-mini
NANO_MODEL=gpt-5.4-nano

# Feature flags
ENABLE_BULK_CASE_DELETE=false
